<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The v57 vault (../Vault): the records every v57 app shares (logins, hosts, connections, folders), in the app group
	     container; the vault keys, connection passwords and the device SSH key in the shared keychain group, and
	     logins' passwords, one-time codes, cards and passkeys in the secrets group, which only Vault and its AutoFill
	     extension list (and the shared group stays first: an item added with no group goes in the first one). iCloud
	     sync through CloudKit. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.v57.shared</string>
		<string>$(AppIdentifierPrefix)dev.v57.secrets</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.v57</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
</dict>
</plist>
