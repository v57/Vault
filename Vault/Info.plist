<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhone and iPad: a background turn now and then to check remotes (the system decides when; no helper). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.v57.vault.refresh</string>
	</array>
	<!-- Invites from other people and devices: v57vault://invite?… (a link, or the QR code's text). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.v57.vault.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>v57vault</string>
			</array>
		</dict>
	</array>
	<!-- Open in Vault: PDFs and pictures from Finder's Open With and the share sheet go to Add Document. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<!-- iPhone and iPad: Vault's Documents folder in Files (On My iPhone › Vault), where decrypted folders open and
	     edits come back to be sealed; files opened in Vault are read where they are (PageReader asks for access). The
	     build settings say the same, but this file's keys win. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Animations and scrolling at up to 120 fps on an iPhone with ProMotion; without it they stop at 60. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Confirms it's you when Vault opens, before a password, card or document number is shown or copied, and before this device's SSH key signs in to a server.</string>
</dict>
</plist>
